')});b.classList.add('nsel')}function ngShowPin(){document.getElementById('npbox').classList.remove('nh');document.getElementById('npin').value='';document.getElementById('nperr').textContent=''}function ngVerifyPin(){if(document.getElementById('npin').value.trim()==='4646')ngOpenPanel('admin');else document.getElementById('nperr').textContent='Invalid Admin PIN'}function ngOpenPanel(role){document.getElementById('ng').style.display='none';document.body.classList.remove('nexa-cust-only','nexa-admin-only');if(role==='admin'){document.body.classList.add('nexa-admin-only')}else{document.body.classList.add('nexa-cust-only')}var ip=document.querySelector('input[placeholder*=message],textarea');if(ip)ip.placeholder=window.nLang==='Hindi'?'???? ????? ?????...':window.nLang==='English'?'Type message here...':'Hinglish me message likhein...'}function ngResetGate(){ngStep(1);document.getElementById('npbox').classList.add('nh');document.getElementById('ng').style.display='flex'}document.addEventListener('DOMContentLoaded',function(){ngResetGate()});setInterval(function(){var b=document.querySelectorAll('select option').length;var r=document.querySelectorAll('#recordsList>div,[id*=record]>div,[id*=booking]>div').length;if(b&&document.getElementById('kpiBiz'))document.getElementById('kpiBiz').textContent=b;if(document.getElementById('kpiBook'))document.getElementById('kpiBook').textContent=r},1000);</script;
