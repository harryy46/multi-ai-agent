# Render > Environment me ye sab daalo. Is file ko .env naam se copy karke local me bhi chala sakte ho.
# .env ko kabhi GitHub par commit mat karna.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=smart_booking
GEMINI_API_KEY=your_gemini_key
# Comma-separated, pehla try hoga, fail ho to agla. Google ki official model list se naam verify karo.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Kam se kam 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
